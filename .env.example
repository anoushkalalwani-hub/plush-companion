# Backend configuration. Copy to .env for local development. Never commit .env.
# Provider keys live on the backend only, never on the device (PRD §4.1, §9).

# Provider mode: "fake" (default) or "live". Enable live only after D-003 is answered.
LLM_PROVIDER_MODE=fake
SPEECH_PROVIDER_MODE=fake
MODERATION_PROVIDER_MODE=fake

# Groq (D-016). Leave empty in fake mode. No model has a default; set all three before live use.
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GROQ_JUDGE_MODEL=
GROQ_MODERATION_MODEL=
# Speech-to-text for the laptop voice simulator (D-022), e.g. whisper-large-v3-turbo.
GROQ_STT_MODEL=
# Text-to-speech for the simulator (D-023), e.g. canopylabs/orpheus-v1-english (preview; accept
# its terms in the Groq console first). Voices: autumn, diana, hannah, austin, daniel, troy.
GROQ_TTS_MODEL=
GROQ_TTS_VOICE=

# Cartesia text-to-speech, the simulator's default voice (D-024). Opt out of training at
# https://play.cartesia.ai/privacy/data-controls before use (D-003).
CARTESIA_API_KEY=
CARTESIA_MODEL=
CARTESIA_VOICE_ID=

# Timeouts (seconds). Exceeding any of these triggers a fail-closed fallback.
LLM_TIMEOUT_SECONDS=8
CLASSIFIER_TIMEOUT_SECONDS=3
VALIDATOR_TIMEOUT_SECONDS=3

# Session context (in memory only; see D-008)
SESSION_MAX_TURNS=6
SESSION_IDLE_TIMEOUT_SECONDS=300

# M1 development stand-in for device credentials (D-010). Unset = every request rejected.
DEV_DEVICE_TOKEN=

# Database
DATABASE_URL=postgresql://plush:plush@localhost:5432/plush

# Must stay disabled for the MVP (PRD §8.1, §13)
PERSISTENT_MEMORY_ENABLED=false
STORE_AUDIO=false
STORE_TRANSCRIPTS=false

# Local Kokoro voice, the simulator's default when set (D-025). Download kokoro-v1.0.onnx and
# voices-v1.0.bin from https://github.com/thewh1teagle/kokoro-onnx/releases/tag/model-files-v1.1
# into models/kokoro/ (git-ignored). Voices: bm_fable, bm_george, am_michael, af_heart, ...
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=
KOKORO_VOICE=

# Audio devices (D-026), e.g. a USB speaker and microphone on a Raspberry Pi. A number from
# `python -m device.simulator --list-devices`, or part of the device name. Empty = system default.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
