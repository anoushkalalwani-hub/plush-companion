# Backend configuration. Copy to .env for local development. Never commit .env.
# Provider keys live on the backend only, never on the device (PRD §4.1, §9).

# Provider mode: "fake" (default) or "live". Enable live only after D-003 is answered.
LLM_PROVIDER_MODE=fake
SPEECH_PROVIDER_MODE=fake
MODERATION_PROVIDER_MODE=fake

# Groq (D-016). Leave empty in fake mode. No model has a default; set all three before live use.
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GROQ_JUDGE_MODEL=
GROQ_MODERATION_MODEL=
# Speech-to-text for the laptop voice simulator (D-022), e.g. whisper-large-v3-turbo.
GROQ_STT_MODEL=

# Timeouts (seconds). Exceeding any of these triggers a fail-closed fallback.
LLM_TIMEOUT_SECONDS=8
CLASSIFIER_TIMEOUT_SECONDS=3
VALIDATOR_TIMEOUT_SECONDS=3

# Session context (in memory only; see D-008)
SESSION_MAX_TURNS=6
SESSION_IDLE_TIMEOUT_SECONDS=300

# M1 development stand-in for device credentials (D-010). Unset = every request rejected.
DEV_DEVICE_TOKEN=

# Database
DATABASE_URL=postgresql://plush:plush@localhost:5432/plush

# Must stay disabled for the MVP (PRD §8.1, §13)
PERSISTENT_MEMORY_ENABLED=false
STORE_AUDIO=false
STORE_TRANSCRIPTS=false
